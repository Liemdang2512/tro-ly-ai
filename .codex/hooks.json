    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash scripts/phien.sh nen codex", "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" scripts/phien.sh nen codex", "timeout": 20 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash scripts/phien.sh dong codex", "commandWindows": "\"C:\\Program Files\\Git\\bin\\bash.exe\" scripts/phien.sh dong codex", "timeout": 20 } ] }
